%% =========================================================================
%% Proscenium DFD Level 2: Video Lifecycle Workflow
%% Ingestion, AI Upscaling, HLS Transcoding, Curation, Streaming & View Gate
%% =========================================================================

flowchart TD
    %% External Entities
    EE_DIR["Director"]
    EE_ADM["Administrator"]
    EE_VIE["Viewer"]
    EE_CLD["Cloudinary CDN"]
    EE_DOCKER["Docker / TensorFlow Engine\n(miratmu/ffmpeg-tensorflow)"]
    EE_SMTP["SMTP Mail Server"]

    %% Data Stores
    D_FILM[("D4: film_collection")]
    D_CAST[("D5: cast")]
    D_VIEW[("D9: video_views")]
    D_SESS[("D6: watch_sessions")]
    D_LOG[("D7: watch_session_log")]
    D_HIST[("D8: watch_history")]
    D_NOTIF[("D17: notifications")]
    D_VIEWER[("D1: viewers_collection")]

    %% =====================================================================
    %% PHASE A: INGESTION & METADATA PREPARATION
    %% =====================================================================
    subgraph PHASE_INGESTION ["Phase 1: Ingestion & Metadata Processing"]
        P2_1["2.1 Receive Multipart Upload\n(Validate role, video file, cast JSON, thumbnail)"]
        P2_2["2.2 Probe Video Stream\n(FFprobe: duration in seconds, width, height)"]
        P2_3["2.3 Process Cast Members\n(Upload photos to Cloudinary, insert cast records)"]
        P2_4["2.4 Prepare Poster / Thumbnail\n(Validate custom file OR extract frame at 1s via FFmpeg;\nupload to Cloudinary)"]
    end

    EE_DIR -->|"Upload film (.mp4), metadata, poster, cast"| P2_1
    P2_1 -->|"Write temporary original.mp4 to disk"| P2_2
    P2_1 -->|"Extract cast member photos"| P2_3
    P2_3 -->|"Upload cast photo"| EE_CLD
    EE_CLD -->|"Return cast photo URL"| P2_3
    P2_3 -->|"Insert cast documents with videoId"| D_CAST

    P2_2 -->|"Raw video path & duration"| P2_4
    P2_4 -->|"Upload thumbnail image"| EE_CLD
    EE_CLD -->|"Return secure thumbnail URL"| P2_4

    %% =====================================================================
    %% PHASE B: AI ENHANCEMENT & HLS TRANSCODING
    %% =====================================================================
    subgraph PHASE_TRANSCODING ["Phase 2: AI Super-Resolution & HLS Transcoding Pipeline"]
        P2_5{"2.5 Resolution Check\nSource Height < 1080p\n& use_upscale == True?"}
        P2_6["2.6 AI Super-Resolution\n(Docker: extract YUV planes, run ESPCN 2x/4x model on Y plane,\nlanczos scale U/V planes, merge & encode)"]
        P2_7["2.7 Select Resolution Ladder\n(Filter resolutions <= input height * 1.2;\n360p, 480p, 720p, 1080p, 1440p, 2160p)"]
        P2_8["2.8 Multi-bitrate HLS Transcode\n(FFmpeg: 6s segments, libx264, AAC 128k, index_{res}.m3u8)"]
        P2_9["2.9 Cloudinary Media Dispatch\n(Upload .ts segments, rewrite index playlists with remote URLs,\ngenerate master.m3u8, upload master playlist)"]
        P2_10["2.10 Disk Cleanup & DB Persistence\n(Purge local media directory, insert film document with\nstatus='ready', moderationStatus='pending', visibility='private')"]
    end

    P2_2 -->|"Resolution (w x h)"| P2_5
    P2_5 -->|"Yes (<1080p)"| P2_6
    P2_5 -->|"No (>=1080p or disabled)"| P2_7
    P2_6 -->|"Mount /data & execute ESPCN model"| EE_DOCKER
    EE_DOCKER -->|"Return ai_upscaled.mp4"| P2_6
    P2_6 -->|"Upscaled video file"| P2_7

    P2_7 -->|"Active rendition targets"| P2_8
    P2_8 -->|"Generated .ts segments & index playlists"| P2_9
    P2_9 -->|"Upload video segments & m3u8 manifests"| EE_CLD
    EE_CLD -->|"Return segment & master manifest URLs"| P2_9
    P2_9 -->|"Manifest URL & renditions metadata"| P2_10
    P2_10 -->|"Store film document (status=ready, visibility=private)"| D_FILM
    P2_10 -->|"Notify admin: New film awaiting review"| D_NOTIF

    %% =====================================================================
    %% PHASE C: ADMINISTRATIVE MODERATION & CURATION
    %% =====================================================================
    subgraph PHASE_MODERATION ["Phase 3: Administrative Moderation & Curation"]
        P3_1["3.1 Review Moderation Queue\n(Fetch pending submissions, inspect metadata, play stream preview)"]
        P3_2{"3.2 Moderation Decision"}
        P3_3["3.3 Reject Film\n(Set moderationStatus='rejected', visibility='private',\nrecord reason in moderationHistory)"]
        P3_4["3.4 Approve Film\n(Set moderationStatus='approved', visibility='public',\npublishedAt=now)"]
        P3_5["3.5 Audience Notification Fan-Out\n(Queue in-app notification & batch HTML email via SMTP\nto all opted-in viewers)"]
    end

    EE_ADM -->|"Inspect pending films"| P3_1
    D_FILM -->|"Read film details & stream URL"| P3_1
    P3_1 -->|"Submit moderation action"| P3_2

    P3_2 -->|"Reject (with reason)"| P3_3
    P3_3 -->|"Update film moderationStatus=rejected"| D_FILM
    P3_3 -->|"Insert rejection notice for director"| D_NOTIF
    P3_3 -->|"Send rejection email via SMTP"| EE_SMTP

    P3_2 -->|"Approve (with optional comment)"| P3_4
    P3_4 -->|"Update film moderationStatus=approved, visibility=public"| D_FILM
    P3_4 -->|"Insert approval notice for director"| D_NOTIF
    P3_4 -->|"Send approval email via SMTP"| EE_SMTP
    P3_4 -->|"Trigger new release broadcast"| P3_5

    P3_5 -->|"Query opted-in viewers"| D_VIEWER
    P3_5 -->|"Insert in-app notification for each viewer"| D_NOTIF
    P3_5 -->|"Queue batch new release email"| EE_SMTP

    %% =====================================================================
    %% PHASE D: VIEWING, STREAMING & PLAYBACK VERIFICATION
    %% =====================================================================
    subgraph PHASE_STREAMING ["Phase 4: Streaming, Heartbeats & View Verification"]
        P4_1["4.1 Initialize Playback Session\n(Verify age restrictions & maturity settings, get master.m3u8,\nfetch resume position from history, create session)"]
        P4_2["4.2 HLS Adaptive Stream Playback\n(Client video player downloads manifests & segments)"]
        P4_3["4.3 Playback Heartbeat Ping\n(Receive currentTimeSec, calculate wall-clock gap,\nverify anti-drift tolerance <= 5s)"]
        P4_4["4.4 Accumulate Watch Time & Log\n(Increment accumulatedSeconds in session & append-only watch_session_log,\nupdate resume position in watch_history)"]
        P4_5{"4.5 Qualified View Gate\naccumulatedSeconds / durationSec\n>= 0.75 (75%) ?"}
        P4_6["4.6 Credit Qualified View\n(Insert unique record in video_views; increment views & uniqueViews\non film; check viewing milestones 10..100k)"]
    end

    EE_VIE -->|"Click watch video"| P4_1
    D_FILM -->|"Read hlsManifestUrl & ageRestricted"| P4_1
    D_HIST -->|"Read currentTimeSec (resume)"| P4_1
    P4_1 -->|"Initialize session document"| D_SESS
    P4_1 -->|"Create append-only play record"| D_LOG
    P4_1 -->|"Return stream_url & resume time"| EE_VIE

    EE_VIE -->|"Request HLS video segments"| EE_CLD
    EE_CLD -->|"Deliver media segments (.ts)"| EE_VIE

    EE_VIE -->|"Periodic heartbeat (currentTimeSec every ~5-10s)"| P4_3
    P4_3 -->|"Read current session state"| D_SESS
    P4_3 -->|"Credited playback delta"| P4_4
    P4_4 -->|"Update accumulatedSeconds in session"| D_SESS
    P4_4 -->|"Increment total seconds in log"| D_LOG
    P4_4 -->|"Upsert current playhead position & progress %"| D_HIST
    P4_4 --> P4_5

    P4_5 -->|"No (<75%)"| P4_3
    P4_5 -->|"Yes (>=75% for first time)"| P4_6
    P4_6 -->|"Insert unique (videoId, viewerId) record"| D_VIEW
    P4_6 -->|"Increment views and uniqueViews"| D_FILM
    P4_6 -->|"If milestone reached, notify director"| D_NOTIF
